[Unit]
Description=Tune CPU cores: disable turboboost, downclocking, etc.
# Tune before the judgedaemons start. We cannot order against the template
# domjudge-judgedaemon@.service, but its instances are After=create-cgroups.
Before=create-cgroups.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/disable-turboboost_ht
RemainAfterExit=true
ExecStartPre=/bin/sleep 10

[Install]
WantedBy=multi-user.target
# Do not judge on an untuned machine.
RequiredBy=create-cgroups.service
