# Test bed for the ansible provisioning: bare machines that are reachable as
# root over SSH with the key generated by `make`, which is the state the
# playbooks expect to start from. Everything else is left to ansible.
#
# Machines and addresses come from hosts.vagrant (the test inventory).
#
# VARIANT=icpc  start from the ICPC contest image (see make-icpc-box.sh)
#               instead of the stock Ubuntu cloud image. These are separate
#               machines with the same addresses, so only one set can run.
# BOX           override the base box, BOX_VERSION pins its version

ENV["VAGRANT_DEFAULT_PROVIDER"] ||= "libvirt"

variant = ENV.fetch("VARIANT", "")
abort "Unknown VARIANT '#{variant}': use VARIANT=icpc or leave it unset." unless ["", "icpc"].include?(variant)
icpc = variant == "icpc"
starting = (ARGV & %w[up provision reload]).any?

key_file = File.expand_path("../roles/ssh/files/id_ed25519", __dir__)
if starting && !(File.exist?(key_file) && File.exist?("#{key_file}.pub"))
  abort "Run ./bootstrap.sh first (generates the SSH key)."
end
pubkey = File.exist?("#{key_file}.pub") ? File.read("#{key_file}.pub").strip : ""

# /14 so that both 10.2.x and 10.3.x are on one segment.
NETMASK = "255.252.0.0"
PREFIX = 14
SPECS = {
  "domserver" => { cpus: 2, memory: 3072 },
  # cpucore defaults to [2] => isolcpus=2, so a judgehost needs >= 3 CPUs.
  "judgehost" => { cpus: 3, memory: 3072 },
}

machines = {}
group = nil
File.foreach(File.join(__dir__, "hosts.vagrant")) do |line|
  next if line =~ /^\s*([#;]|$)/
  if line =~ /^\s*\[([^\]]+)\]/
    group = $1
  elsif SPECS.key?(group) && line =~ /^\s*(\S+)\s.*\bansible_host=(\S+)/
    machines[$1] = SPECS[group].merge(ip: $2)
  end
end
vm_name = ->(name) { icpc ? "icpc-#{name}" : name }

if starting
  # ansible must be configured for the same image as the machines.
  all_yml = File.expand_path("../group_vars/onprem/all.yml", __dir__)
  configured = File.exist?(all_yml) && File.read(all_yml)[/^ICPC_IMAGE:\s*(\S+)/, 1]
  unless configured == icpc.to_s
    abort "group_vars/onprem/all.yml is not set up for #{icpc ? 'VARIANT=icpc' : 'the stock image'}: rerun ./bootstrap.sh with the same VARIANT."
  end

  # Refuse to start one set while the other one runs: they share the addresses.
  others = machines.keys.map { |n| icpc ? n : "icpc-#{n}" }
  running = `virsh -c qemu:///system list --name 2>/dev/null`.split
  clash = running.select { |d| others.any? { |n| d.end_with?("_#{n}") } }
  abort "Halt the other variant first (vagrant halt with#{icpc ? 'out' : ''} VARIANT=icpc): #{clash.join(' ')}" unless clash.empty?
end

Vagrant.configure("2") do |config|
  config.vm.box = ENV.fetch("BOX", icpc ? "icpc-image" : "cloud-image/ubuntu-26.04")
  config.vm.box_version = ENV["BOX_VERSION"] if ENV["BOX_VERSION"]
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.boot_timeout = 600
  if icpc
    # No vagrant user on this image: make-icpc-box.sh installed our key for root.
    config.ssh.username = "root"
    config.ssh.private_key_path = key_file
    config.ssh.insert_key = false
  end

  machines.each do |name, m|
    config.vm.define(vm_name.(name)) do |node|
      node.vm.hostname = name
      # Static addresses only: libvirt refuses a DHCP range this large.
      # The ICPC image uses NetworkManager, which Vagrant's own (netplan based)
      # setup leaves unreachable, so its NIC is configured below instead.
      node.vm.network "private_network", ip: m[:ip], netmask: NETMASK,
                      auto_config: !icpc, libvirt__dhcp_enabled: false,
                      libvirt__network_name: "domjudge-test"
      node.vm.provider("libvirt") do |v|
        v.cpus = m[:cpus]
        v.memory = icpc ? m[:memory] + 1024 : m[:memory]
      end
      node.vm.provider("virtualbox") { |v| v.cpus = m[:cpus]; v.memory = m[:memory] }

      if icpc
        # The image has only a few GiB free; make-icpc-box.sh enlarged the disk,
        # grow the root partition and filesystem to match.
        node.vm.provision "shell", privileged: false, inline: <<~SH
          set -eu
          dev=$(findmnt -no SOURCE /)
          disk=/dev/$(lsblk -no PKNAME "$dev")
          /usr/sbin/sfdisk --relocate gpt-bak-std "$disk" || true
          echo ', +' | /usr/sbin/sfdisk -N "$(cat /sys/class/block/"${dev##*/}"/partition)" --no-reread --force "$disk"
          partx -u "$disk"
          resize2fs "$dev"
          nmcli connection delete dj-private >/dev/null 2>&1 || true
          nmcli connection add type ethernet ifname eth1 con-name dj-private \
            connection.autoconnect-priority 100 \
            ipv4.method manual ipv4.addresses #{m[:ip]}/#{PREFIX} ipv6.method disabled
          nmcli connection up dj-private
        SH
      else
        node.vm.provision "shell", inline: <<~SH
          set -eu
          install -d -m 700 /root/.ssh
          grep -qF '#{pubkey}' /root/.ssh/authorized_keys 2>/dev/null || echo '#{pubkey}' >> /root/.ssh/authorized_keys
          chmod 600 /root/.ssh/authorized_keys
          command -v python3 >/dev/null || (apt-get update && apt-get install -y python3)
          echo 'PermitRootLogin prohibit-password' > /etc/ssh/sshd_config.d/00-root-login.conf
          systemctl reload ssh
        SH
      end
    end
  end
end
