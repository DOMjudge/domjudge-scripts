#!/bin/bash
set -eu -o pipefail

shopt -s extglob

# Maximum exit latency (in microseconds) of C-states that are left enabled.
max_cstate_latency=5

errors=0
error () {
    echo "Error: $*" >&2
    errors=1
}

# Expand a kernel cpulist (e.g. "0-3,8,10-11") into a space separated list.
expand_cpulist () {
    local list="$1" part start end
    local -a parts
    IFS=',' read -ra parts <<< "$list"
    for part in "${parts[@]}"; do
        [ -n "$part" ] || continue
        IFS='-' read -r start end <<< "$part"
        seq "$start" "${end:-$start}"
    done
}

# Disable SMT, taking offline all hyperthreading sibling cores but one.
SMT_CONTROL=/sys/devices/system/cpu/smt/control
if [ -f $SMT_CONTROL ]; then
    case "$(cat $SMT_CONTROL)" in
        on)           echo off > $SMT_CONTROL ;;
        off|forceoff) ;;
        notsupported) echo "SMT not supported by this CPU, nothing to disable." ;;
        *)            echo "Warning: SMT control state '$(cat $SMT_CONTROL)', not changing it." ;;
    esac
else
    echo "Warning: '$SMT_CONTROL' not found, could not disable SMT."
fi

isolated="$(cat /sys/devices/system/cpu/isolated)"
if [ -z "$isolated" ]; then
    echo "Warning: no isolated cores found, check the 'isolcpus' kernel parameter."
fi
ecores=()
if [ -f /sys/devices/cpu_atom/cpus ]; then
    mapfile -t ecores < <(expand_cpulist "$(cat /sys/devices/cpu_atom/cpus)")
fi

# Only tune the isolated cores, as those are used for judging.
for core in $(expand_cpulist "$isolated"); do
    cpu=/sys/devices/system/cpu/cpu$core

    # Check that the isolated cores are online and are not efficiency cores.
    # cpu0 often has no 'online' file since it cannot be taken offline.
    if [ -f $cpu/online ] && [ "$(cat $cpu/online)" -ne 1 ]; then
        error "isolated core $core is offline (is it an SMT sibling?)"
        continue
    fi
    for ecore in "${ecores[@]}"; do
        if [ "$core" -eq "$ecore" ]; then
            error "isolated core $core is an efficiency core"
        fi
    done

    # Reenable stuff in case we are rerunning this script.
    if [ -f $cpu/cpufreq/scaling_governor ]; then
        chmod u+w $cpu/cpufreq/scaling_governor
    fi
    for boundary in min max; do
        if [ -f $cpu/cpufreq/scaling_${boundary}_freq ]; then
            chmod u+w $cpu/cpufreq/scaling_${boundary}_freq
        fi
    done

    # Set governor to performance and do not allow changes later on.
    if [ -f $cpu/cpufreq/scaling_governor ]; then
        echo performance > $cpu/cpufreq/scaling_governor
        chmod a-w $cpu/cpufreq/scaling_governor
    fi

    # Hardware maximum performance.
    if [ -f $cpu/cpufreq/scaling_min_freq ] && [ -f $cpu/cpufreq/scaling_max_freq ]; then
        cp $cpu/cpufreq/scaling_{max,min}_freq
        chmod a-w $cpu/cpufreq/scaling_{max,min}_freq
    fi

    # Disable C-states with a too high exit latency, (re)enable the others.
    for state in $cpu/cpuidle/state*; do
        if [ ! -f $state/latency ] || [ ! -f $state/disable ]; then continue; fi
        if [ "$(cat $state/latency)" -gt "$max_cstate_latency" ]; then
            echo 1 > $state/disable
        else
            echo 0 > $state/disable
        fi
    done
done

DIR_INTEL=/sys/devices/system/cpu/intel_pstate
DIR_AMD=/sys/devices/system/cpu/cpufreq
# Same for some ARM CPUs
FILE_AMD=$DIR_AMD/boost
if [ -d $DIR_INTEL ]; then
    # now disable turbo boost
    FILE=$DIR_INTEL/no_turbo
    echo -n 1 > $FILE || echo "Could not write to '$FILE', ignoring for now..."
    if [ $(cat $FILE) -ne 1 ]; then
        echo "Error: turboboost still enabled!"
        exit 1
    fi

    # increase freq from powersaving to normal, but don't overclock
    echo 100 > $DIR_INTEL/min_perf_pct
    echo 100 > $DIR_INTEL/max_perf_pct
elif [ -f $FILE_AMD ]; then
    # now disable boosting
    echo -n 0 > $FILE_AMD || echo "Could not write to '$FILE_AMD', ignoring for now..."
    if [ $(cat $FILE_AMD) -ne 0 ]; then
        echo "Error: turboboost still enabled!"
        exit 1
    fi
else
    echo "Warning: kernel (turbo) boost config not found in '$DIR_INTEL' or '$DIR_AMD'."
fi

[ "$errors" -eq 0 ] || exit 1
